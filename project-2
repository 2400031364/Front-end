    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // DOM Elements
            const loginSection = document.getElementById('loginSection');
            const dashboard = document.getElementById('dashboard');
            const loginForm = document.getElementById('loginForm');
            const logoutBtn = document.getElementById('logoutBtn');
            const userTypeTabs = document.querySelectorAll('.user-type-tab');
            const usernameLabel = document.getElementById('usernameLabel');
            const captchaText = document.getElementById('captchaText');
            const refreshCaptcha = document.getElementById('refreshCaptcha');
            const userGreeting = document.getElementById('userGreeting');
            const userDetails = document.getElementById('userDetails');
            const userAvatar = document.getElementById('userAvatar');
            const dashboardTitle = document.getElementById('dashboardTitle');
            const optionCards = document.querySelectorAll('.option-card');
            const contentSections = document.querySelectorAll('.content-section');
            const closeContentButtons = document.querySelectorAll('.close-content');
            const coursesList = document.getElementById('coursesList');
            const academicYear = document.getElementById('academicYear');
            const semester = document.getElementById('semester');
            const subOptionCards = document.querySelectorAll('.sub-option-card');
            const paymentOptions = document.querySelectorAll('.payment-option');
            
            // Sample course data
            const courses = [
                {
                    code: 'CS301',
                    name: 'Data Structures & Algorithms',
                    credits: 4,
                    instructor: 'Dr. Sarah Johnson',
                    schedule: 'Mon, Wed, Fri - 10:00 AM to 11:00 AM',
                    location: 'Computer Lab 3',
                    description: 'This course covers fundamental data structures and algorithms, including arrays, linked lists, trees, graphs, sorting, and searching algorithms.',
                    status: 'Completed',
                    grade: 'A'
                },
                {
                    code: 'MATH202',
                    name: 'Discrete Mathematics',
                    credits: 3,
                    instructor: 'Dr. Robert Miller',
                    schedule: 'Tue, Thu - 2:00 PM to 3:30 PM',
                    location: 'Math Building Room 205',
                    description: 'Introduction to discrete mathematical structures with emphasis on applications in computer science. Topics include logic, sets, relations, functions, combinatorics, and graph theory.',
                    status: 'Completed',
                    grade: 'B+'
                },
                {
                    code: 'PHY102',
                    name: 'Modern Physics',
                    credits: 4,
                    instructor: 'Dr. Michael Brown',
                    schedule: 'Mon, Wed, Fri - 1:00 PM to 2:00 PM',
                    location: 'Physics Lab 1',
                    description: 'This course covers special relativity, quantum mechanics, atomic physics, nuclear physics, and particle physics.',
                    status: 'In Progress',
                    grade: '--'
                },
                {
                    code: 'CS302',
                    name: 'Database Management Systems',
                    credits: 3,
                    instructor: 'Prof. Jennifer Lee',
                    schedule: 'Tue, Thu - 11:00 AM to 12:30 PM',
                    location: 'Computer Lab 2',
                    description: 'Introduction to database systems, data modeling, relational databases, SQL, normalization, transaction processing, and database design.',
                    status: 'In Progress',
                    grade: '--'
                },
                {
                    code: 'HUM101',
                    name: 'Professional Ethics',
                    credits: 2,
                    instructor: 'Dr. David Wilson',
                    schedule: 'Mon - 3:00 PM to 4:30 PM',
                    location: 'Humanities Building Room 101',
                    description: 'Examination of ethical issues in professional environments, with emphasis on case studies in technology and engineering fields.',
                    status: 'In Progress',
                    grade: '--'
                }
            ];
            
            // Generate random CAPTCHA
            function generateCaptcha() {
                const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
                let captcha = '';
                for (let i = 0; i < 4; i++) {
                    captcha += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                return captcha;
            }
            
            // Set initial CAPTCHA
            let currentCaptcha = generateCaptcha();
            captchaText.textContent = currentCaptcha;
            
            // Refresh CAPTCHA
            refreshCaptcha.addEventListener('click', function() {
                currentCaptcha = generateCaptcha();
                captchaText.textContent = currentCaptcha;
            });
            
            // User type tabs functionality
            userTypeTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    userTypeTabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    
                    const userType = this.getAttribute('data-user-type');
                    if (userType === 'student') {
                        usernameLabel.textContent = 'Student ID';
                    } else if (userType === 'teacher') {
                        usernameLabel.textContent = 'Teacher ID';
                    } else {
                        usernameLabel.textContent = 'Admin ID';
                    }
                });
            });
            
            // Login form submission
            loginForm.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const username = document.getElementById('username').value;
                const password = document.getElementById('password').value;
                const captcha = document.getElementById('captcha').value;
                const activeUserType = document.querySelector('.user-type-tab.active').getAttribute('data-user-type');
                
                // Simple validation
                if (username && password && captcha === currentCaptcha) {
                    // Hide login section and show dashboard
                    loginSection.style.display = 'none';
                    dashboard.style.display = 'flex';
                    
                    // Update dashboard based on user type
                    if (activeUserType === 'student') {
                        userGreeting.textContent = `Welcome, ${username}!`;
                        userDetails.textContent = `Student ID: ${username} | Computer Science`;
                        userAvatar.textContent = username.charAt(0).toUpperCase();
                        dashboardTitle.textContent = 'Student Dashboard';
                    } else if (activeUserType === 'teacher') {
                        userGreeting.textContent = `Welcome, Professor ${username}!`;
                        userDetails.textContent = `Teacher ID: ${username} | Department of Computer Science`;
                        userAvatar.textContent = 'P';
                        dashboardTitle.textContent = 'Faculty Dashboard';
                    } else {
                        userGreeting.textContent = `Welcome, Administrator ${username}!`;
                        userDetails.textContent = `Admin ID: ${username} | System Administrator`;
                        userAvatar.textContent = 'A';
                        dashboardTitle.textContent = 'Administrator Dashboard';
                    }
                    
                    // Populate courses
                    populateCourses();
                } else {
                    alert('Please fill all fields correctly and enter the correct CAPTCHA.');
                }
            });
            
            // Logout functionality
            logoutBtn.addEventListener('click', function() {
                dashboard.style.display = 'none';
                loginSection.style.display = 'flex';
                loginForm.reset();
                currentCaptcha = generateCaptcha();
                captchaText.textContent = currentCaptcha;
                
                // Hide all content sections
                contentSections.forEach(section => {
                    section.classList.remove('active');
                });
            });
            
            // Option cards functionality
            optionCards.forEach(card => {
                card.addEventListener('click', function() {
                    const contentId = this.getAttribute('data-content') + '-content';
                    
                    // Hide all content sections
                    contentSections.forEach(section => {
                        section.classList.remove('active');
                    });
                    
                    // Show the selected content section
                    document.getElementById(contentId).classList.add('active');
                });
            });
            
            // Close content sections
            closeContentButtons.forEach(button => {
                button.addEventListener('click', function() {
                    this.closest('.content-section').classList.remove('active');
                });
            });
            
            // Sub-option cards functionality
            subOptionCards.forEach(card => {
                card.addEventListener('click', function() {
                    const subContentId = this.getAttribute('data-sub-content') + '-sub';
                    
                    // Remove active class from all sub-option cards
                    subOptionCards.forEach(c => c.classList.remove('active'));
                    // Add active class to clicked sub-option card
                    this.classList.add('active');
                    
                    // Hide all sub-content sections
                    const subContents = document.querySelectorAll('.sub-content');
                    subContents.forEach(section => {
                        section.classList.remove('active');
                    });
                    
                    // Show the selected sub-content section
                    document.getElementById(subContentId).classList.add('active');
                });
            });
            
            // Payment options functionality
            paymentOptions.forEach(option => {
                option.addEventListener('click', function() {
                    paymentOptions.forEach(opt => opt.classList.remove('selected'));
                    this.classList.add('selected');
                });
            });
            
            // Populate courses
            function populateCourses() {
                coursesList.innerHTML = '';
                
                courses.forEach(course => {
                    const courseCard = document.createElement('div');
                    courseCard.className = 'course-card';
                    courseCard.innerHTML = `
                        <div class="course-code">${course.code}</div>
                        <div class="course-name">${course.name}</div>
                        <div class="course-info">
                            <i class="fas fa-user"></i>
                            <span>${course.instructor}</span>
                        </div>
                        <div class="course-info">
                            <i class="fas fa-clock"></i>
                            <span>${course.schedule}</span>
                        </div>
                        <div class="course-info">
                            <i class="fas fa-map-marker-alt"></i>
                            <span>${course.location}</span>
                        </div>
                        <div class="course-info">
                            <i class="fas fa-graduation-cap"></i>
                            <span>${course.credits} Credits</span>
                        </div>
                        <div class="course-info">
                            <i class="fas fa-info-circle"></i>
                            <span>Status: ${course.status}</span>
                        </div>
                        ${course.grade !== '--' ? `<div class="course-info">
                            <i class="fas fa-star"></i>
                            <span>Grade: ${course.grade}</span>
                        </div>` : ''}
                    `;
                    
                    coursesList.appendChild(courseCard);
                });
            }
            
            // Initialize courses on page load
            populateCourses();
            
            // Update courses when academic year or semester changes
            academicYear.addEventListener('change', populateCourses);
            semester.addEventListener('change', populateCourses);
        });
    </script>
</body>
